{
  "permissions": {
    "allow": [
      "Bash(php -l *)",
      "Bash(git status*)",
      "Bash(git diff*)"
    ],
    "deny": [
      "Read(src/webapp/config.php)",
      "Edit(src/webapp/config.php)",
      "Write(src/webapp/config.php)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "php \"$CLAUDE_PROJECT_DIR/.claude/hooks/php-lint.php\""
          }
        ]
      }
    ]
  }
}
